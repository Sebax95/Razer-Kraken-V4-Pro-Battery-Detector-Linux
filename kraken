#!/usr/bin/env python3
"""Control a Razer Kraken V4 Pro headset via hidraw.

Usage:
  kraken battery [--json]
  kraken lights R G B     # e.g. kraken lights 255 0 0
  kraken lights off
  kraken lights toggle    # alternates between off and the last color used
  kraken lights restore   # re-applies the last state (color or off) as-is
  kraken eq <preset>      # game | movie | music | custom | 0x.. (raw byte)
  kraken eq status [--json]
  kraken mic monitor <on|off>       # mic monitoring ("tono local")
  kraken mic monitor-volume <0-15>
  kraken balance <0-20>               # Game-Chat crossfade (0=game, 20=chat)
  kraken volume [chat|game] <0-100>  # sets PipeWire's software level for
                                      # that mix-input (game if omitted),
                                      # and makes it the active output
  kraken volume master [chat|game] <0-100>  # sets the REAL device gain for
                                      # that mix-input (ALSA, no root needed)
  kraken volume status [--json]      # active output + both volumes for both
  kraken output <chat|game>          # switches the active output without
                                      # touching any volume
  kraken watch            # polls the EQ preset and notifies on change
                           # (the only way to catch the physical preset
                           # button -- see the "eq" section below)
"""
import glob
import json
import os
import select
import subprocess
import sys
import time

# =============================================================================
# shared
# =============================================================================


def find_dock_node():
    for path in glob.glob("/dev/input/by-id/*Kraken_V4_Pro*if04-hidraw"):
        return os.path.realpath(path)
    return None


def notify(title, body):
    try:
        subprocess.run(
            ["notify-send", "-a", "Razer Kraken V4 Pro", "-i", "audio-headphones", title, body],
            capture_output=True,
        )
    except FileNotFoundError:
        pass  # notify-send not installed -- notification is a nice-to-have, not required


# =============================================================================
# battery
# =============================================================================
"""Read the battery level of a Razer Kraken V4 Pro via hidraw.

Protocol (captured from Synapse with usbmon, 2026-08-12):
  command  (64B, report ID 0x02): 02 00 60 00 00 00 04 00 | 00 TT CC 00 | ...
  response (64B, interrupt IN):   02 02 60 00 00 00 LL 00 | 00 TT CC 01 | VV BB ...
  TT = 0x80 (dock -> wireless headset) or 0x00 (wired headset)
  CC = command: 0x21 battery (BB = 0-100, 0xff = no RF link),
       0x2a charging state (BB = 01 charging), 0x20 RF link (BB = 01 linked)
  VV = data-valid flag (always 01 on a good reply; NOT the charging state)
"""

BATTERY_VID = "1532"
BATTERY_PID_DOCK = "0568"
BATTERY_PID_WIRED = "0567"
CMD_BATTERY = 0x21
CMD_CHARGING = 0x2A


def _battery_find_hidraws(pid):
    """Return the /dev/hidraw* nodes belonging to the given VID:PID."""
    nodes = []
    for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            uevent = open(os.path.join(path, "device", "uevent")).read()
        except OSError:
            continue
        if f"HID_ID=0003:0000{BATTERY_VID}:0000{pid}".casefold() in uevent.casefold():
            nodes.append("/dev/" + os.path.basename(path))
    return nodes


def _battery_query(node, target, cmdid):
    """Send a command and wait for the response carrying the same ID (byte 10)."""
    cmd = bytearray(64)
    cmd[0] = 0x02          # report ID
    cmd[2] = 0x60
    cmd[6] = 0x04          # payload length
    cmd[9] = target        # 0x80 = via dock (RF), 0x00 = direct
    cmd[10] = cmdid
    fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
    try:
        os.write(fd, bytes(cmd))
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline:
            r, _, _ = select.select([fd], [], [], deadline - time.monotonic())
            if not r:
                break
            data = os.read(fd, 64)
            # skip the dock's periodic status frames: match our command's echo
            if len(data) >= 14 and data[0] == 0x02 and data[10] == cmdid:
                return data[13]
    finally:
        os.close(fd)
    return None


def _battery_fail(as_json, message):
    if as_json:
        print(json.dumps({"error": message}))
    else:
        print(message, file=sys.stderr)
    return 1


def cmd_battery(argv):
    as_json = "--json" in argv
    wired = _battery_find_hidraws(BATTERY_PID_WIRED)
    dock = _battery_find_hidraws(BATTERY_PID_DOCK)
    if not wired and not dock:
        return _battery_fail(as_json, "Razer Kraken V4 Pro not found (neither dock nor cable).")

    # Query directly while the cable is plugged in; otherwise via the dock (RF).
    attempts = [(n, 0x00, "cable") for n in wired] + [(n, 0x80, "dock/RF") for n in dock]
    for node, target, via in attempts:
        try:
            level = _battery_query(node, target, CMD_BATTERY)
        except PermissionError:
            print(f"No permission on {node} (udev rule missing).", file=sys.stderr)
            continue
        except OSError:
            continue
        if level is None or level == 0xFF:
            continue  # the dock answers 0xff when it has no RF link to the headset
        try:
            charging = _battery_query(node, target, CMD_CHARGING)
        except OSError:
            charging = None
        if as_json:
            print(json.dumps({"battery": level, "charging": charging == 0x01, "via": via}))
        else:
            state = "charging" if charging == 0x01 else "discharging"
            print(f"Battery: {level}% ({state}, via {via})")
        return 0

    return _battery_fail(as_json, "The headset did not respond (powered off or out of dock range?).")


# =============================================================================
# lights
# =============================================================================
"""Set the RGB lighting of a Razer Kraken V4 Pro via hidraw.

Two paths, both captured from Synapse with usbmon (2026-08-13/20):

  Wired (USB cable direct to the headset, PID 0567, if05) -- PREFERRED:
    Plain write(), no setup needed. Confirmed reliable across real
    cable unplug/replug cycles. Header TT byte (offset 9) = 0x00.

  Dock/RF (via the dock, PID 0568, if04) -- fallback when not wired:
    A plain color write alone only works if the dock's internal state
    is already "unlocked" (e.g. right after Synapse itself talked to
    it). After the *headset* is power-cycled, the dock silently
    ignores color writes again until it sees the same ~140-command
    recovery sequence Synapse sends on reconnect (~/.local/share/
    kraken-rgb/dock-recovery-sequence.hex, captured by watching a full
    real recovery byte-for-byte -- see project memory for how). It's a
    grab-bag of config/telemetry/capability queries on the *same*
    Output Report 0x02 channel as the color write, just with different
    payloads; replaying it verbatim (with ~20ms spacing -- sending it
    with no delay floods the device and only some commands land)
    reliably re-unlocks the dock without needing Synapse/Windows at
    all. Confirmed 2/2 across real headset power-cycles. Since there's
    no way to tell from Linux whether the dock is currently locked,
    this always runs before every dock-path color write (adds ~3s).

Both share the same 64-byte Output Report ID 0x02 body for the actual
color write: bytes 0-14 are a fixed header (only byte 9, TT, differs
between the two paths), then an R,G,B triplet tiled from byte 15 to
byte 63.
"""

LIGHTS_STATE_FILE = os.path.expanduser("~/.cache/kraken-rgb-state")
# Separate from LIGHTS_STATE_FILE (which also stores "0,0,0" for off) --
# this only ever holds the last real (non-off) color, so toggling back on
# restores it instead of always falling back to LIGHTS_DEFAULT_ON_COLOR.
LIGHTS_LAST_COLOR_FILE = os.path.expanduser("~/.cache/kraken-rgb-last-color")
LIGHTS_RECOVERY_FILE = os.path.expanduser("~/.local/share/kraken-rgb/dock-recovery-sequence.hex")
LIGHTS_DEFAULT_ON_COLOR = (0, 255, 0)  # bright green -- Razer's official #44D62C looked too dark on the actual LED ring; used only the very first time, before any real color has been set


def _lights_find_wired_node():
    for path in glob.glob("/dev/input/by-id/*Razer_Inc_Razer_Kraken_V4_Pro*if05-hidraw"):
        return os.path.realpath(path)
    return None


def _lights_build_frame(tt, r, g, b):
    buf = bytearray(64)
    buf[0:15] = bytes.fromhex("020060000000210f03") + bytes([tt]) + bytes(4) + bytes([0x08])
    for i in range(15, 64):
        buf[i] = (r, g, b)[(i - 15) % 3]
    return bytes(buf)


def _lights_dock_recover(fd):
    try:
        with open(LIGHTS_RECOVERY_FILE) as f:
            lines = [l.strip() for l in f if l.strip()]
    except FileNotFoundError:
        return
    for line in lines:
        data = bytes.fromhex(line.replace(" ", ""))
        buf = bytearray(64)
        buf[0:len(data)] = data
        os.write(fd, bytes(buf))
        time.sleep(0.02)
    time.sleep(0.1)


def _lights_send_color(r, g, b):
    wired = _lights_find_wired_node()
    if wired is not None:
        fd = os.open(wired, os.O_RDWR)
        try:
            os.write(fd, _lights_build_frame(0x00, r, g, b))
        finally:
            os.close(fd)
        return "cable"

    dock = find_dock_node()
    if dock is not None:
        fd = os.open(dock, os.O_RDWR)
        try:
            _lights_dock_recover(fd)
            os.write(fd, _lights_build_frame(0x80, r, g, b))
        finally:
            os.close(fd)
        return "dock/RF"

    return None


def cmd_lights(argv):
    if len(argv) == 3:
        r, g, b = (int(x) for x in argv)
    elif argv == ["off"]:
        r, g, b = 0, 0, 0
    elif argv == ["toggle"]:
        try:
            with open(LIGHTS_STATE_FILE) as f:
                state = f.read().strip()
        except FileNotFoundError:
            state = "off"
        if state in ("off", "0,0,0"):
            try:
                with open(LIGHTS_LAST_COLOR_FILE) as f:
                    r, g, b = (int(x) for x in f.read().strip().split(","))
            except (FileNotFoundError, ValueError):
                r, g, b = LIGHTS_DEFAULT_ON_COLOR
        else:
            r, g, b = 0, 0, 0
    elif argv == ["restore"]:
        # Re-applies the last state as-is (color OR off) -- used to
        # auto-recover after the headset reconnects. Always re-sends,
        # even "off": without this, a power-cycle leaves the ring on
        # the dock's own always-on default lighting instead of staying
        # off, which defeats the point of having turned it off.
        try:
            with open(LIGHTS_STATE_FILE) as f:
                state = f.read().strip()
        except FileNotFoundError:
            return 0
        if state in ("off", ""):
            r, g, b = 0, 0, 0
        else:
            try:
                r, g, b = (int(x) for x in state.split(","))
            except ValueError:
                return 0
    else:
        print("Usage: kraken lights R G B | off | toggle | restore", file=sys.stderr)
        return 1

    via = _lights_send_color(r, g, b)
    if via is None:
        print("Kraken V4 Pro no encontrado (ni cable ni dock).", file=sys.stderr)
        return 1

    with open(LIGHTS_STATE_FILE, "w") as f:
        f.write(f"{r},{g},{b}")
    if (r, g, b) != (0, 0, 0):
        with open(LIGHTS_LAST_COLOR_FILE, "w") as f:
            f.write(f"{r},{g},{b}")
    print(f"RGB: {r},{g},{b} (via {via})")
    return 0


# =============================================================================
# eq
# =============================================================================
"""Read or switch the EQ preset of a Razer Kraken V4 Pro (dock/RF path only).

Protocol captured from Synapse with usbmon (2026-08-24): a 64-byte HID
output report (report ID 0x02), same header shape as the battery/charging
protocol but a different command family:

    request:  02 00 60 00 00 00 05 00 | 00 80 CC 00 | ...
    response: 02 02 60 00 00 00 05 00 | 00 80 CC 01 | 01 PP 00 00

`CC=0x93` (SET) carries the target preset directly in the request body
(`01 PP 00 00` right after the header, `PP` = preset ID) rather than
being a plain query -- sending it changes the preset immediately.
`CC=0x13` (GET) is a plain query (matching the shape used for battery's
`0x21`/`0x2a`) and returns the *current* preset in the response's `PP`
byte. Confirmed by ear (real audio, A/B tested) and by round-tripping
set-then-get:

    game   = 0x07
    custom = 0xff
    music  = 0x08
    movie  = 0x09

(The dock's `CC=0x13` responses also appear unprompted while Synapse's
own EQ UI is actively being clicked in -- but NOT just from sitting idle
with the tab open, and NOT from the physical preset button alone with
nothing polling. So on Linux, detecting a physical button press means
actively polling with the GET query yourself; see the "watch" section.)

A separate command (`0x95`) returns the active preset's 10-band gain
array -- not needed just to read/switch the current preset name.

Confirmed working with a single write, no dock-recovery-sequence replay
needed -- unlike lights, this channel didn't need it even right after a
fresh connection. Replaying the recovery sequence first was tried and
actually caused write timeouts on the following EQ command, so don't
add it back without re-testing carefully. Untested so far whether this
survives a real headset power-cycle the way RGB needed the recovery
sequence for.
"""

EQ_PRESETS = {
    "game": 0x07,
    "custom": 0xFF,
    "music": 0x08,
    "movie": 0x09,
}


def eq_preset_name(preset_id):
    return next((k for k, v in EQ_PRESETS.items() if v == preset_id), f"0x{preset_id:02x}").capitalize()


def _eq_set_preset(fd, preset_id):
    buf = bytearray(64)
    payload = bytes.fromhex("020060000000050000809300") + bytes([0x01, preset_id, 0x00, 0x00])
    buf[0:len(payload)] = payload
    os.write(fd, bytes(buf))


def eq_get_preset(fd, timeout=1.5):
    """Query the dock for the current preset. fd must be O_NONBLOCK."""
    cmd = bytearray(64)
    cmd[0] = 0x02
    cmd[2] = 0x60
    cmd[6] = 0x05
    cmd[9] = 0x80
    cmd[10] = 0x13
    os.write(fd, bytes(cmd))
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        r, _, _ = select.select([fd], [], [], deadline - time.monotonic())
        if not r:
            break
        data = os.read(fd, 64)
        if len(data) >= 14 and data[0] == 0x02 and data[10] == 0x13:
            return data[13]
    return None


def cmd_eq(argv):
    if len(argv) not in (1, 2):
        print("Usage: kraken eq <game|movie|music|custom|0x..> | status [--json]", file=sys.stderr)
        return 1

    node = find_dock_node()
    if node is None:
        if len(argv) == 2 and argv[1] == "--json":
            print(json.dumps({"preset": None}))
            return 0
        print("Kraken V4 Pro (dock, if04) no encontrado.", file=sys.stderr)
        return 1

    arg = argv[0].lower()

    if arg == "status":
        as_json = len(argv) == 2 and argv[1] == "--json"
        fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
        try:
            preset_id = eq_get_preset(fd)
        finally:
            os.close(fd)
        if preset_id is None:
            if as_json:
                print(json.dumps({"preset": None}))
                return 0
            print("Sin respuesta del dock.", file=sys.stderr)
            return 1
        name = eq_preset_name(preset_id)
        if as_json:
            # Machine-readable form for KrakenEQ.qml -- lowercase key so it
            # matches the internal EQ_PRESETS dict / QML preset names directly,
            # no notification (this runs silently whenever the control
            # window opens, not just on a real user-initiated change).
            print(json.dumps({"preset": name.lower()}))
            return 0
        print(f"EQ: {name}")
        notify("Ecualizador", name)
        return 0

    if arg in EQ_PRESETS:
        preset_id = EQ_PRESETS[arg]
    else:
        try:
            preset_id = int(arg, 0)
        except ValueError:
            print(f"Preset desconocido: {arg!r} (opciones: {', '.join(EQ_PRESETS)}, status, o un byte 0x..)", file=sys.stderr)
            return 1

    fd = os.open(node, os.O_RDWR)
    try:
        _eq_set_preset(fd, preset_id)
    finally:
        os.close(fd)

    name = eq_preset_name(preset_id)
    print(f"EQ: {name}")
    # No notify() here on purpose -- "kraken watch" (if running) already
    # notifies on any preset change, whether it came from this command,
    # the physical button, or Synapse. Calling notify() here too would
    # double it up. `status` above still notifies since it's a read-only
    # check the watcher wouldn't otherwise announce.
    return 0


# =============================================================================
# mic
# =============================================================================
"""Control the Razer Kraken V4 Pro's microphone monitoring (dock/RF path only).

Captured from Synapse with usbmon (2026-08-28), same 64-byte report-0x02
family as battery/EQ, two more commands in it:

    CC=0x98  monitoring on/off   -- payload `01 EE 00 00`, EE = 1 on / 0 off
    CC=0x99  monitoring volume   -- payload `01 VV 00 00`, VV = 0-15 (matches
                                     Synapse's 0-15 slider range)

Both ack the same way as EQ's SET (`CC 01 | 01 00 00 00`).

Mic mute (the main on/off toggle) and mic volume (0-100) do NOT go through
this channel -- mute is a separate 1-byte HID SET_REPORT-shaped control
transfer (`bmRequestType=0x21 bRequest=0x01 wValue=0x0100 wIndex=0x0200`,
payload `01`=muted/`00`=unmuted) that hidraw's plain write()/HIDIOCSFEATURE
can't send (wrong bRequest for a standard SET_REPORT), and volume looks like
a normal USB Audio Class Feature Unit SET_CUR. Neither is implemented here
yet -- would need raw USBDEVFS_CONTROL access, not just hidraw.
"""

MIC_MONITOR_CC = 0x98
MIC_MONITOR_VOLUME_CC = 0x99


def _mic_send(fd, cc, value):
    buf = bytearray(64)
    payload = bytes.fromhex("02006000000005000080") + bytes([cc, 0x00, 0x01, value, 0x00, 0x00])
    buf[0:len(payload)] = payload
    os.write(fd, bytes(buf))


def cmd_mic(argv):
    if len(argv) not in (1, 2) or argv[0] not in ("monitor", "monitor-volume"):
        print("Usage: kraken mic monitor <on|off> | monitor-volume <0-15>", file=sys.stderr)
        return 1

    node = find_dock_node()
    if node is None:
        print("Kraken V4 Pro (dock, if04) no encontrado.", file=sys.stderr)
        return 1

    if argv[0] == "monitor":
        if len(argv) != 2 or argv[1] not in ("on", "off"):
            print("Usage: kraken mic monitor <on|off>", file=sys.stderr)
            return 1
        fd = os.open(node, os.O_RDWR)
        try:
            _mic_send(fd, MIC_MONITOR_CC, 1 if argv[1] == "on" else 0)
        finally:
            os.close(fd)
        print(f"Mic monitor: {argv[1]}")
        return 0

    # monitor-volume
    if len(argv) != 2:
        print("Usage: kraken mic monitor-volume <0-15>", file=sys.stderr)
        return 1
    try:
        vol = int(argv[1])
    except ValueError:
        print(f"Volumen inválido: {argv[1]!r}", file=sys.stderr)
        return 1
    if not (0 <= vol <= 15):
        print("El volumen de monitorización va de 0 a 15.", file=sys.stderr)
        return 1
    fd = os.open(node, os.O_RDWR)
    try:
        _mic_send(fd, MIC_MONITOR_VOLUME_CC, vol)
    finally:
        os.close(fd)
    print(f"Mic monitor volume: {vol}")
    return 0


# =============================================================================
# balance
# =============================================================================
"""Set the on-device Game-Chat balance mix (Synapse's "EQUILIBRIO
JUEGO-CHAT" slider).

Captured from Synapse with usbmon (2026-08-29) via the landmark technique
(EQ-preset clicks before/after), same 64-byte report-0x02 channel as
RGB/EQ/mic:

    CC=0xdc, payload = 01 VV 00 00      (VV = 0x00-0x14, i.e. 0-20 decimal)
    20 = full "MÁS CHAT" (left extreme)
    0  = full "MÁS JUEGO" (right extreme)
    10 = centered/balanced

This is a single device-side crossfade between whatever's currently on the
Chat and Game mix inputs (see the "volume"/"output" section above for
those) -- not a per-app router. Whichever is favored gets faded up toward
its own configured level, the other faded down, not just muted.
"""

BALANCE_CC = 0xdc


def cmd_balance(argv):
    if len(argv) != 1:
        print("Usage: kraken balance <0-20>  (0=más juego, 20=más chat, 10=centrado)", file=sys.stderr)
        return 1
    try:
        value = int(argv[0])
    except ValueError:
        print(f"Valor inválido: {argv[0]!r}", file=sys.stderr)
        return 1
    if not (0 <= value <= 20):
        print("El balance va de 0 (más juego) a 20 (más chat).", file=sys.stderr)
        return 1

    node = find_dock_node()
    if node is None:
        print("Kraken V4 Pro (dock, if04) no encontrado.", file=sys.stderr)
        return 1

    fd = os.open(node, os.O_RDWR)
    try:
        _mic_send(fd, BALANCE_CC, value)
    finally:
        os.close(fd)
    print(f"Balance juego-chat: {value}/20")
    return 0


# =============================================================================
# volume / output
# =============================================================================
"""Set levels for the Kraken V4 Pro's two independent mix inputs, through
PipeWire, and pick which one is the active output.

This device exposes two independent USB Audio playback interfaces, "Game"
and "Chat" (PipeWire sink suffixes `...playback.1.0` and `...playback.0.0`
respectively -- both are misleadingly named "..._Chat_Razer_..." at the
PipeWire level, only the trailing index tells them apart), each its own
separate mix *input* feeding an on-device Game-Chat balance mixer (Synapse's
"EQUILIBRIO JUEGO-CHAT" slider: centered = both audible, either extreme =
only that one, in between a lerp of the two). "Game" is meant for general
listening, "Chat" for something like a Discord call.

`kraken volume [chat|game] <0-100>` sets PipeWire's own SOFTWARE gain for
that sink (defaults to "game" if omitted, for backward compatibility) and
makes it the active output. This is layered on top of the device's own real
hardware gain (`kraken volume master`) -- lowering one does not affect the
other, confirmed by ear 2026-08-31.

`kraken output <chat|game>` just switches which sink is active, without
touching any volume -- useful since PipeWire/ACP tends to reset the default
sink back to Chat on its own (a reconnect, reboot, or Synapse re-pair).
"""

_OUTPUT_SINK_SUFFIX = {"chat": "playback.0.0", "game": "playback.1.0"}
_OUTPUT_ALSA_INDEX = {"chat": 0, "game": 1}


def _find_kraken_sink(target):
    suffix = _OUTPUT_SINK_SUFFIX[target]
    try:
        out = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and "Kraken" in parts[1] and parts[1].endswith(suffix):
            return parts[1]
    return None


def cmd_output(argv):
    if len(argv) != 1 or argv[0] not in _OUTPUT_SINK_SUFFIX:
        print("Usage: kraken output <chat|game>", file=sys.stderr)
        return 1
    sink = _find_kraken_sink(argv[0])
    if sink is None:
        print(f"No se encontró la interfaz de audio '{argv[0]}' del Kraken (¿está conectado?).", file=sys.stderr)
        return 1
    subprocess.run(["pactl", "set-default-sink", sink], check=False)
    print(f"Output activo: {argv[0]}")
    return 0


def _pactl_sink_volume_pct(sink):
    result = subprocess.run(["pactl", "get-sink-volume", sink], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if "%" not in line:
            continue
        try:
            return int(line.split("/")[1].strip().rstrip("%"))
        except (IndexError, ValueError):
            return None
    return None


def _alsa_pcm_pct(card, index):
    # Reads back the dB value (not ALSA's own "[XX%]", which is linear in
    # dB) and runs it through the SAME curve `cmd_volume_master` uses to
    # set it, via `_db_to_percent` -- otherwise the percent shown here
    # wouldn't match the percent that was actually asked for. See the
    # "master" section's curve comment for why.
    result = subprocess.run(["amixer", "-c", str(card), "sget", f"PCM,{index}"], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        for chunk in line.split("["):
            close = chunk.find("]")
            if close == -1 or not chunk[:close].endswith("dB"):
                continue
            try:
                return _db_to_percent(float(chunk[:close - 2]))
            except ValueError:
                continue
    return None


def cmd_volume_status(argv):
    as_json = "--json" in argv

    default_sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True).stdout.strip()
    output = None
    for target, suffix in _OUTPUT_SINK_SUFFIX.items():
        if default_sink.endswith(suffix):
            output = target
            break

    pipewire = {}
    for target in _OUTPUT_SINK_SUFFIX:
        sink = _find_kraken_sink(target)
        pipewire[target] = _pactl_sink_volume_pct(sink) if sink else None

    card = _find_kraken_alsa_card()
    master = {}
    for target, index in _OUTPUT_ALSA_INDEX.items():
        master[target] = _alsa_pcm_pct(card, index) if card is not None else None

    info = {"output": output, "pipewire": pipewire, "master": master}
    if as_json:
        print(json.dumps(info))
    else:
        print(f"Output activo: {output}")
        print(f"PipeWire   -- chat: {pipewire['chat']}%  game: {pipewire['game']}%")
        print(f"Real(ALSA) -- chat: {master['chat']}%  game: {master['game']}%")
    return 0


def cmd_volume(argv):
    if argv[:1] == ["master"]:
        return cmd_volume_master(argv[1:])
    if argv[:1] == ["status"]:
        return cmd_volume_status(argv[1:])
    target = "game"
    rest = argv
    if argv[:1] and argv[0] in _OUTPUT_SINK_SUFFIX:
        target = argv[0]
        rest = argv[1:]
    if len(rest) != 1:
        print("Usage: kraken volume [chat|game] <0-100> | master [chat|game] <0-100>", file=sys.stderr)
        return 1
    try:
        pct = int(rest[0])
    except ValueError:
        print(f"Volumen inválido: {rest[0]!r}", file=sys.stderr)
        return 1
    if not (0 <= pct <= 100):
        print("El volumen va de 0 a 100.", file=sys.stderr)
        return 1

    sink = _find_kraken_sink(target)
    if sink is None:
        print(f"No se encontró la interfaz de audio '{target}' del Kraken (¿está conectado?).", file=sys.stderr)
        return 1

    subprocess.run(["pactl", "set-default-sink", sink], check=False)
    subprocess.run(["pactl", "set-sink-volume", sink, f"{pct}%"], check=False)
    print(f"PipeWire volume ({target} sink): {pct}% -- separate from the real device gain, see 'kraken volume master'")
    return 0


# --- master (real on-device volume, via ALSA) -------------------------------
"""kraken volume master <0-100>

The device's real, overall output gain -- what the headset itself actually
plays at, as opposed to the "Game"/"Chat" PCM levels above (which are each
one *input* to the device's own internal Game-Chat balance mixer, not the
final output stage).

**2026-08-29/31: this was wrongly assumed unreachable without raw USB for
most of a day.** The device's USB descriptor declares TWO separate
AudioControl domains: interface 0's (covering streams 1,2 -- Mic + "Chat")
and interface 5's own independent one (covering stream 6 -- "Game"), each
with its own Feature Unit (entity 5 for Chat, entity 8 for Game/master).
Both turned out to already be fully exposed by `snd-usb-audio` as completely
ordinary ALSA simple-mixer controls -- `amixer -c N scontrols` shows them as
`'PCM',0` (Chat/entity 5) and `'PCM',1` (Game/entity 8) -- no raw ioctls, no
driver detach, no root, ever needed. What actually happened: earlier
sessions kept testing through `kraken volume`/PipeWire, which applies its
own *separate software* gain stage on top of these ALSA hardware controls
and normally leaves them wherever they last were -- so the real hardware
gain looked "stuck low" when it was PipeWire's own volume that was low (or
the default sink had silently reverted to Chat, see `kraken volume`'s
docstring), not because the hardware control was unreachable. Confirmed live
2026-08-31: raising/lowering ONLY the ALSA `'PCM',1` control changes real
perceived loudness with PipeWire's own volume held constant, and vice versa
-- they are genuinely two independent knobs, exactly like Windows'
Synapse-volume-slider vs Windows-OS-volume.

The whole raw-USB/driver-detach saga from earlier this session (interface
1.5 ioctl dance, sysfs unbind/bind of one or all sibling interfaces, the
kernel `mixer_maps` quirk idea) is now known to have been solving an
already-solved problem the hard way. Kept in git history for the protocol
research (the dB curve/mute-command notes are still accurate, just not
needed to reach this from Linux) but removed from the working tree.
"""


def _find_kraken_alsa_card():
    try:
        with open("/proc/asound/cards") as f:
            text = f.read()
    except OSError:
        return None
    for line in text.splitlines():
        if "Kraken" not in line or "[" not in line:
            continue
        index = line.split("[", 1)[0].strip()
        if index.isdigit():
            return int(index)
    return None


# ALSA's own 0-100% here is LINEAR in dB (confirmed: 50% always lands
# exactly halfway between the control's min/max dB) -- but dB is already a
# log scale, so a straight line in dB is exponential in perceived loudness,
# which is why the low end of the range feels like "almost nothing changes"
# and the top ~20% feels like it does all the work. Synapse's own volume
# slider does NOT do this -- captured from real hardware traffic
# (2026-08-29, see the "master" section history) it uses a curve that's
# steeper at the bottom and flatter at the top, so each % step feels roughly
# even by ear. Reusing that curve here instead of ALSA's naive percent.
_MASTER_VOLUME_CURVE = [(3, -49.93), (50, -10.42), (100, 0.0)]
_ALSA_MIN_DB = -74.0
_ALSA_MAX_DB = 0.0


def _percent_to_db(pct):
    points = _MASTER_VOLUME_CURVE
    if pct <= 0:
        return _ALSA_MIN_DB
    if pct <= points[0][0]:
        t = pct / points[0][0]
        return _ALSA_MIN_DB + t * (points[0][1] - _ALSA_MIN_DB)
    if pct >= points[-1][0]:
        return points[-1][1]
    for (p0, db0), (p1, db1) in zip(points, points[1:]):
        if p0 <= pct <= p1:
            t = (pct - p0) / (p1 - p0)
            return db0 + t * (db1 - db0)
    return points[-1][1]  # unreachable, keeps the type checker happy


def _db_to_percent(db):
    """Inverse of `_percent_to_db`, for reading a raw dB value back as the
    same curved percentage it would take to set it (see `_alsa_pcm_pct`)."""
    points = _MASTER_VOLUME_CURVE
    if db <= _ALSA_MIN_DB:
        return 0
    if db <= points[0][1]:
        t = (db - _ALSA_MIN_DB) / (points[0][1] - _ALSA_MIN_DB)
        return round(t * points[0][0])
    if db >= points[-1][1]:
        return 100
    for (p0, db0), (p1, db1) in zip(points, points[1:]):
        if db0 <= db <= db1:
            t = (db - db0) / (db1 - db0)
            return round(p0 + t * (p1 - p0))
    return 100  # unreachable, keeps the type checker happy


def _alsa_raw_range(card, index):
    result = subprocess.run(["amixer", "-c", str(card), "sget", f"PCM,{index}"], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if "Limits:" not in line:
            continue
        parts = line.split()
        try:
            return int(parts[-3]), int(parts[-1])
        except (IndexError, ValueError):
            return None
    return None


def _db_to_raw(db, min_raw, max_raw):
    db = max(_ALSA_MIN_DB, min(_ALSA_MAX_DB, db))
    t = (db - _ALSA_MIN_DB) / (_ALSA_MAX_DB - _ALSA_MIN_DB)
    return round(min_raw + t * (max_raw - min_raw))


def cmd_volume_master(argv):
    target = "game"
    rest = argv
    if argv[:1] and argv[0] in _OUTPUT_ALSA_INDEX:
        target = argv[0]
        rest = argv[1:]
    if len(rest) != 1:
        print("Usage: kraken volume master [chat|game] <0-100>", file=sys.stderr)
        return 1
    try:
        pct = int(rest[0])
    except ValueError:
        print(f"Volumen inválido: {rest[0]!r}", file=sys.stderr)
        return 1
    if not (0 <= pct <= 100):
        print("El volumen va de 0 a 100.", file=sys.stderr)
        return 1

    card = _find_kraken_alsa_card()
    if card is None:
        print("Kraken V4 Pro no encontrado en ALSA.", file=sys.stderr)
        return 1

    index = _OUTPUT_ALSA_INDEX[target]
    raw_range = _alsa_raw_range(card, index)
    if raw_range is None:
        print(f"No pude leer el rango del control 'PCM,{index}'.", file=sys.stderr)
        return 1
    min_raw, max_raw = raw_range
    raw = _db_to_raw(_percent_to_db(pct), min_raw, max_raw)

    result = subprocess.run(
        ["amixer", "-c", str(card), "cset", f"name=PCM Playback Volume,index={index}", f"{raw},{raw}"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"amixer falló: {result.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"Master volume (real, ALSA 'PCM',{index} / {target}): {pct}%")
    return 0




