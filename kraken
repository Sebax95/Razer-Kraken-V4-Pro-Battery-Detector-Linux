"""Poll the Kraken V4 Pro's current EQ preset and notify on change.

Only needed to react to the physical preset button on the headset:
there's no unsolicited notification for that (see the "eq" section
above) so this just polls the same read-only query "eq status" uses,
every couple of seconds, and fires a desktop notification whenever the
reported preset differs from the last poll.

Meant to run continuously (systemd --user unit, or just backgrounded).
"""

WATCH_POLL_INTERVAL = 0.15


def cmd_watch(argv):
    last_preset = None
    fd = None
    node = None

    while True:
        cur_node = find_dock_node()
        if cur_node is None:
            time.sleep(WATCH_POLL_INTERVAL)
            continue
        if cur_node != node or fd is None:
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
            try:
                fd = os.open(cur_node, os.O_RDWR | os.O_NONBLOCK)
            except OSError:
                time.sleep(WATCH_POLL_INTERVAL)
                continue
            node = cur_node

        try:
            preset_id = eq_get_preset(fd, timeout=0.3)
        except OSError:
            try:
                os.close(fd)
            except OSError:
                pass
            fd = None
            node = None
            time.sleep(WATCH_POLL_INTERVAL)
            continue

        if preset_id is not None and preset_id != last_preset:
            if last_preset is not None:  # skip the very first read on startup
                name = eq_preset_name(preset_id)
                notify("Ecualizador", name)
            last_preset = preset_id

        time.sleep(WATCH_POLL_INTERVAL)


