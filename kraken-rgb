#!/usr/bin/env python3
"""Set the RGB lighting of a Razer Kraken V4 Pro via hidraw.

Two paths, both captured from Synapse with usbmon (2026-08-13/20):

  Wired (USB cable direct to the headset, PID 0567, if05) -- PREFERRED:
    Plain write(), no setup needed. Confirmed reliable across real
    cable unplug/replug cycles. Header TT byte (offset 9) = 0x00.

  Dock/RF (via the dock, PID 0568, if04) -- fallback when not wired:
    A plain color write alone only works if the dock's internal state
    is already "unlocked" (e.g. right after Synapse itself talked to
    it). After the *headset* is power-cycled, the dock silently
    ignores color writes again until it sees the same ~140-command
    recovery sequence Synapse sends on reconnect (~/.local/share/
    kraken-rgb/dock-recovery-sequence.hex, captured by watching a full
    real recovery byte-for-byte -- see project memory for how). It's a
    grab-bag of config/telemetry/capability queries on the *same*
    Output Report 0x02 channel as the color write, just with different
    payloads; replaying it verbatim (with ~20ms spacing -- sending it
    with no delay floods the device and only some commands land)
    reliably re-unlocks the dock without needing Synapse/Windows at
    all. Confirmed 2/2 across real headset power-cycles. Since there's
    no way to tell from Linux whether the dock is currently locked,
    this always runs before every dock-path color write (adds ~3s).

Both share the same 64-byte Output Report ID 0x02 body for the actual
color write: bytes 0-14 are a fixed header (only byte 9, TT, differs
between the two paths), then an R,G,B triplet tiled from byte 15 to
byte 63.

Usage:
  kraken-rgb R G B     # e.g. kraken-rgb 255 0 0
  kraken-rgb off
  kraken-rgb toggle    # alternates between off and the last color used
"""
import glob
import os
import sys
import time

STATE_FILE = os.path.expanduser("~/.cache/kraken-rgb-state")
RECOVERY_FILE = os.path.expanduser("~/.local/share/kraken-rgb/dock-recovery-sequence.hex")
DEFAULT_ON_COLOR = (0, 200, 255)


def find_wired_node():
    for path in glob.glob("/dev/input/by-id/*Razer_Inc_Razer_Kraken_V4_Pro*if05-hidraw"):
        return os.path.realpath(path)
    return None


def find_dock_node():
    for path in glob.glob("/dev/input/by-id/*Kraken_V4_Pro*if04-hidraw"):
        return os.path.realpath(path)
    return None


def build_frame(tt, r, g, b):
    buf = bytearray(64)
    buf[0:15] = bytes.fromhex("020060000000210f03") + bytes([tt]) + bytes(4) + bytes([0x08])
    for i in range(15, 64):
        buf[i] = (r, g, b)[(i - 15) % 3]
    return bytes(buf)


def dock_recover(fd):
    try:
        with open(RECOVERY_FILE) as f:
            lines = [l.strip() for l in f if l.strip()]
    except FileNotFoundError:
        return
    for line in lines:
        data = bytes.fromhex(line.replace(" ", ""))
        buf = bytearray(64)
        buf[0:len(data)] = data
        os.write(fd, bytes(buf))
        time.sleep(0.02)
    time.sleep(0.1)


def send_color(r, g, b):
    wired = find_wired_node()
    if wired is not None:
        fd = os.open(wired, os.O_RDWR)
        try:
            os.write(fd, build_frame(0x00, r, g, b))
        finally:
            os.close(fd)
        return "cable"

    dock = find_dock_node()
    if dock is not None:
        fd = os.open(dock, os.O_RDWR)
        try:
            dock_recover(fd)
            os.write(fd, build_frame(0x80, r, g, b))
        finally:
            os.close(fd)
        return "dock/RF"

    return None


def main():
    args = sys.argv[1:]
    if len(args) == 3:
        r, g, b = (int(x) for x in args)
    elif args == ["off"]:
        r, g, b = 0, 0, 0
    elif args == ["toggle"]:
        try:
            with open(STATE_FILE) as f:
                state = f.read().strip()
        except FileNotFoundError:
            state = "off"
        if state in ("off", "0,0,0"):
            r, g, b = DEFAULT_ON_COLOR
        else:
            r, g, b = 0, 0, 0
    elif args == ["restore"]:
        # Re-applies the last state as-is (color OR off) -- used to
        # auto-recover after the headset reconnects. Always re-sends,
        # even "off": without this, a power-cycle leaves the ring on
        # the dock's own always-on default lighting instead of staying
        # off, which defeats the point of having turned it off.
        try:
            with open(STATE_FILE) as f:
                state = f.read().strip()
        except FileNotFoundError:
            return 0
        if state in ("off", ""):
            r, g, b = 0, 0, 0
        else:
            try:
                r, g, b = (int(x) for x in state.split(","))
            except ValueError:
                return 0
    else:
        print(__doc__, file=sys.stderr)
        return 1

    via = send_color(r, g, b)
    if via is None:
        print("Kraken V4 Pro no encontrado (ni cable ni dock).", file=sys.stderr)
        return 1

    with open(STATE_FILE, "w") as f:
        f.write(f"{r},{g},{b}")
    print(f"RGB: {r},{g},{b} (via {via})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
