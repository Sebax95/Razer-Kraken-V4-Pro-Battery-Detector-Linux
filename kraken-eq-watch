#!/usr/bin/env python3
"""Poll the Kraken V4 Pro's current EQ preset and notify on change.

Only needed to react to the physical preset button on the headset:
there's no unsolicited notification for that (see kraken-eq's
docstring) so this just polls the same read-only query kraken-eq
status uses, every couple of seconds, and fires a desktop notification
whenever the reported preset differs from the last poll.

Meant to run continuously (systemd --user unit, or just backgrounded).
"""
import glob
import os
import subprocess
import sys
import time

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

_here = os.path.dirname(os.path.realpath(__file__))
_loader = SourceFileLoader("kraken_eq", os.path.join(_here, "kraken-eq"))
_spec = spec_from_loader("kraken_eq", _loader)
kraken_eq = module_from_spec(_spec)
_loader.exec_module(kraken_eq)

POLL_INTERVAL = 0.15


def main():
    last_preset = None
    fd = None
    node = None

    while True:
        cur_node = kraken_eq.find_dock_node()
        if cur_node is None:
            time.sleep(POLL_INTERVAL)
            continue
        if cur_node != node or fd is None:
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
            try:
                fd = os.open(cur_node, os.O_RDWR | os.O_NONBLOCK)
            except OSError:
                time.sleep(POLL_INTERVAL)
                continue
            node = cur_node

        try:
            preset_id = kraken_eq.get_preset(fd, timeout=0.3)
        except OSError:
            try:
                os.close(fd)
            except OSError:
                pass
            fd = None
            node = None
            time.sleep(POLL_INTERVAL)
            continue

        if preset_id is not None and preset_id != last_preset:
            if last_preset is not None:  # skip the very first read on startup
                name = kraken_eq.preset_name(preset_id)
                kraken_eq.notify(name)
            last_preset = preset_id

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
