#!/usr/bin/env python3
"""Read the battery level of a Razer Kraken V4 Pro via hidraw.

Protocol (captured from Synapse with usbmon, 2026-08-12):
  command  (64B, report ID 0x02): 02 00 60 00 00 00 04 00 | 00 TT CC 00 | ...
  response (64B, interrupt IN):   02 02 60 00 00 00 LL 00 | 00 TT CC 01 | VV BB ...
  TT = 0x80 (dock -> wireless headset) or 0x00 (wired headset)
  CC = command: 0x21 battery (BB = 0-100, 0xff = no RF link),
       0x2a charging state (BB = 01 charging), 0x20 RF link (BB = 01 linked)
  VV = data-valid flag (always 01 on a good reply; NOT the charging state)
"""
import glob
import json
import os
import select
import sys
import time

VID = "1532"
PID_DOCK = "0568"
PID_WIRED = "0567"
CMD_BATTERY = 0x21
CMD_CHARGING = 0x2A


def find_hidraws(pid):
    """Return the /dev/hidraw* nodes belonging to the given VID:PID."""
    nodes = []
    for path in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            uevent = open(os.path.join(path, "device", "uevent")).read()
        except OSError:
            continue
        if f"HID_ID=0003:0000{VID}:0000{pid}".casefold() in uevent.casefold():
            nodes.append("/dev/" + os.path.basename(path))
    return nodes


def query(node, target, cmdid):
    """Send a command and wait for the response carrying the same ID (byte 10)."""
    cmd = bytearray(64)
    cmd[0] = 0x02          # report ID
    cmd[2] = 0x60
    cmd[6] = 0x04          # payload length
    cmd[9] = target        # 0x80 = via dock (RF), 0x00 = direct
    cmd[10] = cmdid
    fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
    try:
        os.write(fd, bytes(cmd))
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline:
            r, _, _ = select.select([fd], [], [], deadline - time.monotonic())
            if not r:
                break
            data = os.read(fd, 64)
            # skip the dock's periodic status frames: match our command's echo
            if len(data) >= 14 and data[0] == 0x02 and data[10] == cmdid:
                return data[13]
    finally:
        os.close(fd)
    return None


def fail(as_json, message):
    if as_json:
        print(json.dumps({"error": message}))
    else:
        print(message, file=sys.stderr)
    return 1


def main():
    as_json = "--json" in sys.argv[1:]
    wired = find_hidraws(PID_WIRED)
    dock = find_hidraws(PID_DOCK)
    if not wired and not dock:
        return fail(as_json, "Razer Kraken V4 Pro not found (neither dock nor cable).")

    # Query directly while the cable is plugged in; otherwise via the dock (RF).
    attempts = [(n, 0x00, "cable") for n in wired] + [(n, 0x80, "dock/RF") for n in dock]
    for node, target, via in attempts:
        try:
            level = query(node, target, CMD_BATTERY)
        except PermissionError:
            print(f"No permission on {node} (udev rule missing).", file=sys.stderr)
            continue
        except OSError:
            continue
        if level is None or level == 0xFF:
            continue  # the dock answers 0xff when it has no RF link to the headset
        try:
            charging = query(node, target, CMD_CHARGING)
        except OSError:
            charging = None
        if as_json:
            print(json.dumps({"battery": level, "charging": charging == 0x01, "via": via}))
        else:
            state = "charging" if charging == 0x01 else "discharging"
            print(f"Battery: {level}% ({state}, via {via})")
        return 0

    return fail(as_json, "The headset did not respond (powered off or out of dock range?).")


if __name__ == "__main__":
    sys.exit(main())
